# Postgres connection string. Use the dedicated RICap Supabase project
# (Project Settings > Database > Connection string > URI). SSL is turned on
# automatically for supabase.co / supabase.com hosts; override with
# PGSSL=true/false if pointing somewhere else.
DATABASE_URL=postgresql://user:password@localhost:5432/ricap

# Long random string used to sign session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

PORT=4200

# Public URL of the portal, used to build invite and password-reset links.
# Local dev: the Vite dev server. Production: https://ricap.retailinnovation.ai
APP_URL=http://localhost:5190

# Transactional email via Resend (same setup as RISE). EMAIL_FROM must be on
# a domain verified in Resend. If either is unset in local dev, emails are
# not sent and login codes / invite links are printed to this terminal
# instead. In production both are required, or nobody can sign in.
RESEND_API_KEY=
EMAIL_FROM=notifications@ricap.retailinnovation.ai

# Set to "production" on Netlify. Never print login codes when production.
NODE_ENV=development

# Document storage (M2). Without these, files are saved in backend/storage
# on this machine (local development only). Once the RICap Supabase project
# exists: Project Settings > Storage > S3 Connection > "New access key", and
# create a private bucket with the name below.
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_DOCUMENTS_BUCKET=ricap-documents
